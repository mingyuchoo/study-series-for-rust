# 이 파일을 .env 로 복사해 실제 값을 채우십시오. .env 는 커밋되지 않습니다.
#
#   cp .env.example .env
#   chmod 600 .env
#   direnv allow
#
# 값에 따옴표를 붙이지 마십시오. direnv 의 dotenv 는 따옴표를 값의 일부로 읽습니다.

# 리소스 주소. 끝에 슬래시를 붙이지 마십시오.
AZURE_OPENAI_ENDPOINT=https://<리소스>.cognitiveservices.azure.com

# 모델 배포 이름입니다. 모델 ID가 아닙니다.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano

# gpt-5 계열은 max_completion_tokens 를 요구합니다(internal/llm 이 처리).
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# 절대 커밋하지 마십시오. 노출되면 Azure 포털에서 즉시 회전(regenerate)하십시오.
AZURE_OPENAI_API_KEY=
