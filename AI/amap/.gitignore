# --- Rust / Cargo ---
/target/
**/target/
!Cargo.lock
# plugins/finance is a separate workspace (wasm32 target), keeps its own lock
*.wasm
*.rs.bk
*.pdb

# --- AMAP runtime artifacts ---
# evidence lake, demo outcome, control-plane/worker logs (config/amap.toml: lake = ".amap/lake")
.amap/
# verification sandboxes created next to a configured workspace
.amap-staging/
.amap-mutants/
# example workspaces generated by the fix loop (examples/*/amap.toml: workspace = ".workspace/next")
**/.workspace/
*.log

# --- Python (demo emulators / trace generators) ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- React / Vite ---
# the repo-root .gitignore drops every package-lock.json; run.sh, Dockerfile and CI need this one
!web/package-lock.json
web/node_modules/
web/dist/
web/*.tsbuildinfo

# --- Secrets / local env ---
# ANTHROPIC_API_KEY, OPENAI_API_KEY, AWS_ENDPOINT_URL, ... belong in .env, never in git
.env
.env.*
!.env.example

# --- Docker / infra local state ---
pgdata/
minio-data/

# --- Editors / OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
