# Copy to .env and fill in real values. .env is gitignored.
# Every AMAP binary (amap, control-plane, llm-gateway) loads .env from the current directory at startup.

# --- Azure OpenAI (chat completions) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Deployment tiers by request effort: High/Xhigh/Max -> DEPLOYMENT, Medium -> _MEDIUM, Low -> _LOW
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_DEPLOYMENT_MEDIUM=gpt-5.4-mini
AZURE_OPENAI_DEPLOYMENT_LOW=gpt-5.4-nano

# --- Azure OpenAI (embeddings for semantic context retrieval) ---
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# --- Other providers (optional) ---
# ANTHROPIC_API_KEY=
# AMAP_ANTHROPIC_MODEL=claude-opus-5
# OPENAI_API_KEY=
# AMAP_OPENAI_MODEL=
