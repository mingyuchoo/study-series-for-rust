FORMAT_WRITE_CMD='cargo fmt --all'
FORMAT_CHECK_CMD='cargo fmt --all -- --check'
LINT_CMD='cargo clippy --locked --all-targets --features test-support -- -D warnings'
UNIT_TEST_CMD='cargo test --locked --features test-support --test bujo_unit'
INTEGRATION_TEST_CMD='cargo test --locked --features test-support --test bujo_integration'
E2E_TEST_CMD='cargo test --locked --features test-support --test bujo_e2e'
