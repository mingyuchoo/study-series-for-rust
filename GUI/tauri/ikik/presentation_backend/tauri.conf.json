{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ikik",
  "version": "0.1.0",
  "identifier": "com.mingyuchoo.ikik",
  "build": {
    "beforeDevCommand": {
      "script": "dx build --release --platform web --debug-symbols false",
      "cwd": "../presentation_frontend",
      "wait": true
    },
    "beforeBuildCommand": {
      "script": "dx build --release --platform web --debug-symbols false",
      "cwd": "../presentation_frontend"
    },
    "frontendDist": "../target/dx/presentation_frontend/release/web/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "IKIK",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
